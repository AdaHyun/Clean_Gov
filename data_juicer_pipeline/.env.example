# Copy this file to .env.local and fill values locally.
# Never commit .env.local or paste API keys into YAML, commands, or logs.

COMPANY_LLM_BASE_URL=
COMPANY_LLM_MODEL=
# The current company provider policy supports an authentication-free endpoint.
# Leave this empty when the server does not require a key.
COMPANY_LLM_API_KEY=

# SiliconFlow is external. It is never selected by default and is blocked for
# restricted/internal data by the pipeline policy.
SILICONFLOW_MODEL=
SILICONFLOW_API_KEY=

# 接口地址
COMPANY_PARSE_API_URL=http://10.61.5.9:8899/PDF-Parser
COMPANY_QUERY_API_URL=http://10.61.5.9:8899/Query
COMPANY_PARSER_POOL_ID=h200

# 异步回调地址必须能被 10.61.5.9 所在网络访问。
# 如果启用 CALLBACK_TOKEN，建议将同一个 token 放进回调 URL。
COMPANY_CALLBACK_URL=http://你的内网IP:8800/callback?token=请替换
COMPANY_CALLBACK_TOKEN=请替换

# 初版默认尝试沿用原 AIHub HMAC 鉴权。
# 可选值：aihub_hmac、access_key、none
COMPANY_AUTH_MODE=aihub_hmac

# aihub_hmac 模式
AIHUB_ACCESS_KEY_ID=
AIHUB_ACCESS_KEY_SECRET=
AIHUB_PRODUCT_CODE=

# access_key 模式（接口方确认 Header 后再改）
COMPANY_ACCESS_KEY=
COMPANY_ACCESS_KEY_HEADER=X-Access-Key
COMPANY_ACCESS_KEY_PREFIX=
